# Used by docker-compose.yml.  Copy to ".env" (never commit it).
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000/api
LOG_LEVEL=info

# Optional email (leave empty = emails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=